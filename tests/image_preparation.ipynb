    "import os\n",
    "\n",
    "imgs = [f for f in os.listdir('../data/truck/images') if f.endswith('.jpg')]\n",
    "\n",
    "for img in imgs:\n",
    "    path = os.path.join('..\\\\data\\\\truck\\\\images', img)\n",
    "    !magick {path} -resize 50% {path}"
   ]
  }
